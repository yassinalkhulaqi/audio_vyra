{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AURIVO",
  "version": "0.1.0",
  "identifier": "com.aurivo.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AURIVO",
        "label": "main",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "publisher": "AURIVO contributors",
    "copyright": "Copyright 2026 AURIVO contributors",
    "category": "AudioVideo",
    "shortDescription": "Real-time voice processing desktop app",
    "longDescription": "AURIVO is a low-latency voice effects chain with dynamics, tone, modulation, pitch and vocal effects, driven from a Tauri desktop app.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": ["msi", "nsis", "deb", "app", "dmg"],
    "windows": {
      "nsis": { "installMode": "perUser" },
      "wix": { "language": "en-US" }
    },
    "macOS": { "minimumSystemVersion": "10.15" },
    "linux": { "deb": { "depends": [] } }
  }
}
